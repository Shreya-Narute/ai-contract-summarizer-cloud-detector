# ── Environment / Secrets ────────────────────────────────────────────────────
# Never commit .env files — they contain passwords and secrets.
.env
.env.*
!.env.example

# ── Node ─────────────────────────────────────────────────────────────────────
frontend/node_modules/
frontend/build/

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
*.egg
dist/
build/
.venv/
venv/

# ── Docker volumes (local runtime data) ──────────────────────────────────────
backend/uploads/
backend/generated/

# ── Root templates/ is a duplicate of backend/templates/ — only backend/ is needed ──
/templates/

# ── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
