# ─────────────────────────────────────────────────────────────────────────────
# .env.example — template for environment variables used by docker-compose.yml
#
# To use locally:
#   cp .env.example .env
#   Edit .env with real values (never commit .env to git)
#
# On Railway/Render: set these as environment variables in the platform UI.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=app
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=ai_contract

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Database connection (must match POSTGRES_* above) ────────────────────────
DATABASE_URL=postgresql://app:change_this_password@postgres:5432/ai_contract

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a strong secret:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace_with_a_long_random_string_at_least_32_chars

# ── CORS ──────────────────────────────────────────────────────────────────────
# Local dev: leave empty to allow any localhost port.
# Production: set to your frontend URL, e.g. https://your-app.up.railway.app
ALLOWED_ORIGINS=

# ── MinIO (object storage — not yet wired in code, keep for future use) ───────
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=change_this_minio_password
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=change_this_minio_password

# ── Frontend build argument ───────────────────────────────────────────────────
# Local dev: leave empty — api.ts falls back to http://localhost:8000
# Production: set to your deployed backend URL
REACT_APP_API_URL=
