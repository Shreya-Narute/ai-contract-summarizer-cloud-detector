# ─────────────────────────────────────────────────────────────────────────────
# .env.example — copy this to .env and fill in real values for production.
# Never commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Backend ──────────────────────────────────────────────────────────────────

# PostgreSQL connection string (provided by Railway/Render/Supabase)
DATABASE_URL=postgresql+psycopg2://user:password@host:5432/dbname

# Redis connection string (provided by Railway/Render/Upstash)
REDIS_URL=redis://default:password@host:6379

# Strong random secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace_with_a_long_random_string

# Comma-separated list of allowed frontend origins (no trailing slash)
# Example: ALLOWED_ORIGINS=https://your-app.up.railway.app
ALLOWED_ORIGINS=http://localhost:3000

# ── MinIO / Object Storage (optional — not yet integrated in code) ───────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio123

# ── Frontend build arg (set on the platform, not in this file) ───────────────
# REACT_APP_API_URL=https://your-backend.up.railway.app
